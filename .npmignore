.vscode-test/**
src/**
resources/**
experiments/**
docs/**
scripts/**
.husky/**
.github/**
.gitignore
.vscodeignore
.eslintrc*
*.map
tsconfig.json
*.ts
.env
*.vsix
*.gif
*.png
*.jpg
*.jpeg
*.svg
.versionrc.json
